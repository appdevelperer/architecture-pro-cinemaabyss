{
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "movies_route": {
        "ClusterId": "movies_cluster",
        "Match": {
          "Path": "/api/movies/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/movies/{**catch-all}" }
        ]
      }
    },
    "Clusters": {
      "movies_cluster": {
        "Destinations": {
          "movies_service": {
            "Address": "http://movies-service:8081"
          },
          "monolith": {
            "Address": "http://monolith:8080"
          }
        }
      }
    }
  }
}